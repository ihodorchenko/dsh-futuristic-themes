{
  "name": "dsh-futuristic-themes",
  "version": "0.1.2",
  "description": "Three cinematic sci-fi themes for DeepSeek Harness: Nostromo Amber, Omni-tool, Renaissance Steel.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./skin.json": "./skin.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "skin.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ihodorchenko/dsh-futuristic-themes.git",
    "directory": "dsh-futuristic-themes"
  },
  "homepage": "https://github.com/ihodorchenko/dsh-futuristic-themes",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "dark-theme",
    "desktop",
    "crt",
    "hud"
  ]
}
